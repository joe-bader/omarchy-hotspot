#!/bin/bash
# Turns the Wi-Fi hotspot on. On first use, creates a NetworkManager profile
# named "Hotspot" (WPA2, 2.4 GHz, shared IPv4 on 10.42.0.1/24) with a random
# password. Usage: hotspot-up [device]

set -euo pipefail
export LC_ALL=C

command -v dnsmasq >/dev/null || { echo "The hotspot needs dnsmasq: omarchy pkg add dnsmasq" >&2; exit 1; }

device=${1:-$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2 == "wifi" { print $1; exit }')}
[[ -n $device ]] || { echo "No Wi-Fi device found" >&2; exit 1; }

uuid=""
while IFS=: read -r u t; do
  [[ $t == 802-11-wireless ]] || continue
  mapfile -t f < <(nmcli -e no -g connection.id,802-11-wireless.mode connection show uuid "$u")
  [[ ${f[1]} == ap ]] || continue
  if [[ -z $uuid || ${f[0]} == Hotspot ]]; then uuid=$u; fi
done < <(nmcli -t -f UUID,TYPE connection show)

if [[ -z $uuid ]]; then
  ssid="$(hostnamectl hostname 2>/dev/null || cat /etc/hostname)-hotspot"
  password=$(LC_ALL=C tr -dc 'abcdefghjkmnpqrstuvwxyz23456789' </dev/urandom | head -c 12)
  nmcli connection add type wifi ifname "$device" con-name Hotspot autoconnect no \
    ssid "${ssid:0:32}" 802-11-wireless.mode ap 802-11-wireless.band bg \
    wifi-sec.key-mgmt wpa-psk wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp \
    wifi-sec.pmf disable wifi-sec.psk "$password" \
    ipv4.method shared ipv4.addresses 10.42.0.1/24 ipv6.method disabled >/dev/null
  uuid=$(nmcli -g connection.uuid connection show id Hotspot)
fi

[[ $(nmcli -t radio wifi) == enabled ]] || nmcli radio wifi on
nmcli --wait 30 connection up uuid "$uuid" ifname "$device" >/dev/null
